NODE_ENV=development
PORT=5000

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/enjaz

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-also-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
TELEGRAM_BOT_TOKEN=your-bot-token-for-notifications
ADMIN_TELEGRAM_ID=your-admin-telegram-chat-id

# ─── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=your-session-secret

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
