backend/sessions/
*.session
*.session-journal

# Database
*.db
*.sqlite

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Prisma
backend/prisma/migrations/

# Test files
coverage/
.nyc_output/

# Docker volumes
postgres_data/
redis_data/

.vercel
